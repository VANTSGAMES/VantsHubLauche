# ─────────────────────────────────────────────────────────────────────────────
# VANTS Discord Bot - Variables de Entorno
# ─────────────────────────────────────────────────────────────────────────────

# Discord
DISCORD_TOKEN=
DISCORD_GUILD_ID=1546641331927908472

# Base de datos (PostgreSQL): cadena del pooler de sesion con sslmode=require.
# Tras la migracion Neon -> Supabase: pooler de Supabase (puerto 5432).
# Ejemplo: postgresql://postgres.REF:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Puerto para health check (Railway/Render)
PORT=8080

# Supervisor de la web (Vants Supervisor Bot): DM del dueno que recibe las alertas
SUPERVISOR_DM_ID=1532612429295521930
# Segundos entre ciclos de envio (opcional, por defecto 25)
SUPERVISOR_INTERVAL=25

# ── Agente VANTS (opcional, ruta instantanea) ────────────────────────────────
# Si publicas services/agent-service (Railway/Render/VPS junto a este bot),
# define AGENT_URL y /agente comando respondera al instante.
# Sin AGENT_URL, las ordenes quedan en la base (agent_comandos) y las procesa el
# ciclo de CI (workflow agente.yml, cada 30 min); las respuestas llegan por DM.
AGENT_URL=
AGENT_TOKEN=
# Segundos entre ciclos del puente agente<->Discord (por defecto 25)
AGENTE_BRIDGE_INTERVAL=25

# ─────────────────────────────────────────────────────────────────────────────
# Instrucciones:
# 1. Copia este archivo a .env
# 2. Rellena los valores vacíos
# 3. NUNCA subas el archivo .env al repo
# ─────────────────────────────────────────────────────────────────────────────
