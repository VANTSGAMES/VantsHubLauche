# VANTS GAMES — Variables de entorno (ahora son Secrets del Worker)
#
# Configúralas con wrangler:
#   wrangler secret put DISCORD_TOKEN
#   wrangler secret put CHANNEL_ID
#
# O desde el dashboard de Cloudflare:
#   Workers & Pages > vants > Settings > Variables and Secrets

# Token del bot: discord.com/developers/applications -> Tu app -> Bot -> Reset Token
DISCORD_TOKEN=el_token_de_tu_bot

# ID del canal donde el bot publica los anuncios
# (clic derecho en el canal -> Copiar ID del canal, con el modo desarrollador activo)
CHANNEL_ID=id_del_canal_de_anuncios

# ── Auth0 (app Machine-to-Machine con acceso a la Management API) ──
# Necesarias para /api/account/email-verify y /api/account/password-reset
# (cambio de email, tickets de verificación y reset de contraseña).
# AUTH0_MGMT_CLIENT_ID=id_de_la_app_m2m
# AUTH0_MGMT_CLIENT_SECRET=el_secret_de_la_app_m2m

# client_id del SPA (el mismo que publica assets/js/auth0-config.js).
# Opcional: solo se adjunta al ticket de verificación de email de Auth0;
# sin él el ticket se crea igual.
# AUTH0_CLIENT_ID=el_client_id_del_spa

# Firma HMAC opcional de /api/discord/notify: al configurarla, cada POST debe
# traer X-Vants-Signature (sha256=<hex> del HMAC-SHA256 de "<timestamp>.<cuerpo>")
# y X-Vants-Timestamp (rechazo de marcas con más de 5 minutos). Sin la variable
# el endpoint sigue aceptando envíos de los orígenes propios.
# DISCORD_NOTIFY_SECRET=una_frase_larga_aleatoria

# Observabilidad opcional (configurar como secrets del Worker).
# SENTRY_DSN=https://public_key@o0.ingest.sentry.io/project_id
# SUPERVISOR_URL=https://<neon-function-host>
